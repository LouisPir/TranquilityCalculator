# URL du backend. Vide = même origine (le proxy Vite relaie /api vers http://localhost:8000 en dev).
VITE_API_URL=

# true  : si le backend est injoignable, l'appli bascule sur une réponse simulée (utile pour la démo front seule).
# false : toute erreur backend est affichée telle quelle.
VITE_ALLOW_MOCK=true
